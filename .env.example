# Mọi giá trị bí mật chỉ đặt ở đây (file .env đã bị .gitignore) hoặc trong
# Vercel → Project → Settings → Environment Variables. Không ghi vào mã nguồn.

# Tài khoản đăng nhập giao diện (bắt buộc)
AUTH_USERNAME=
AUTH_PASSWORD=
# Khóa ký cookie đăng nhập (khuyên dùng, chuỗi ngẫu nhiên dài). Tạo: openssl rand -hex 32
AUTH_SECRET=

# Euler Stream — kết nối TikTok Live (bắt buộc, gói Free là đủ): https://www.eulerstream.com
EULER_API_KEY=
# Không bắt buộc: bỏ trống thì tự lấy từ API key
EULER_ACCOUNT_ID=

# AI dịch & gợi ý trả lời (API tương thích OpenAI)
LLM_BASE_URL=
LLM_MODEL=gemini-3.1-flash-lite
LLM_API_KEY=

# Lưu lịch sử: có DATABASE_URL (Postgres/Neon) thì dùng Postgres, không thì SQLite tại DB_PATH.
# Trên Vercel, thêm Neon qua Storage → biến này được đặt tự động.
DATABASE_URL=
DB_PATH=data/tikcom.sqlite

PORT=3000
