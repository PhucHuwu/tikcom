{
  "name": "tikcom",
  "version": "1.0.0",
  "description": "Trợ lý livestream TikTok: đọc comment, dịch, gợi ý trả lời, cảm ơn quà bằng TTS",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"node --disable-warning=ExperimentalWarning --import tsx --watch server/node.ts\" \"vite\"",
    "build": "vite build",
    "build:vercel": "vite build && node scripts/build-vercel.mjs",
    "start": "vite build --logLevel warn && node --disable-warning=ExperimentalWarning --import tsx server/node.ts",
    "serve": "node --disable-warning=ExperimentalWarning --import tsx server/node.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@hono/node-server": "^2.1.5",
    "@neondatabase/serverless": "^1.2.0",
    "@phosphor-icons/react": "^2.1.10",
    "dotenv": "^18.0.8",
    "hono": "^4.13.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=22.5"
  }
}
